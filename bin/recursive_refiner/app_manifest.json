{
  "app_id": "AV-03-RECURSIVE-REFINER",
  "version": "1.1.2",
  "entry_points": {
    "native_binary": "bin/recursive_refiner/path_refiner.so",
    "java_binding_class": "AvisIntegrationBridge$PathRefinerLib"
  },
  "execution_constraints": {
    "max_backtrack_iterations_per_task": 1000,
    "monte_carlo_exploration_constant": 1.414,
    "heuristic_pruning_enabled": true
  },
  "resources": {
    "heuristic_score_map": "bin/recursive_refiner/heuristic_map.res"
  },
  "permissions": [
    "MUTATE_CONTEXT_TRAJECTORY"
  ]
}
