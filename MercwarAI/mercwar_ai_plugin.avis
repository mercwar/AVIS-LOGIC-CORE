AVIS2026
# ==========================================================================
# FILE: /avis_core/MercwarAI/mercwar_ai_plugin.avis
# DESCRIPTION: Core registration spec connecting custom inference layers.
# ==========================================================================

[MODULE_DESCRIPTOR]
    TARGET_APP_ID  = "AV-INTERFACE-MERCWAR-AI"
    BINARY_SOURCE  = "MercwarAI/libmercwar_ai.so"
    INTERFACE_BIND = "MercwarAI.AvisModelBridge"

[INFERENCE_TUNING]
    DEFAULT_CONFIG_PATH  = "config/avis_system_core.json"
    MAX_RESPONSE_RESERVE = 4096
    TOKEN_LOG_TRACING    = TRUE

[EOF]
AVIS_PLUGIN_INTERFACE_LINK_ACTIVE
