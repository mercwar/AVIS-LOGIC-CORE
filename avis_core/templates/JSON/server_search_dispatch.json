{
  "$schema": "https://json-schema.org",
  "template_id": "AVIS_SERVER_SEARCH_DISPATCH_V1",
  "description": "Direct server execution packet routing payload for index scraping engines.",
  "execution_packet": {
    "engine_routing_key": "web_search_crawler_node",
